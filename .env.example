# Copy to .env.local and fill in. Never commit .env.local.

# Google AI Studio key (Gemini image edit + vision). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional until deployment: persistent cache + rate limiting (Upstash Redis, free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Home-value model (official U.S. Census data). Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Live house-photo search (Unsplash API, free developer app): https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
