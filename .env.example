# Copy to .env.local and fill in. Never commit .env.local.

# Google AI Studio key (Gemini image edit + vision). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional until deployment: persistent cache + rate limiting (Upstash Redis, free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional (value panel, P1): RentCast Developer plan key
RENTCAST_API_KEY=
